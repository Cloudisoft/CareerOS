generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & RBAC
// ============================================================

enum UserRole {
  CANDIDATE
  EMPLOYER
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  phone         String?
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole      @default(CANDIDATE)
  status        AccountStatus @default(ACTIVE)
  avatarUrl     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions                 Session[]
  verificationTokens       VerificationToken[]
  passwordResets           PasswordResetToken[]
  candidateProfile         CandidateProfile?
  employerProfile          EmployerProfile?
  extensionSessions        ExtensionSession[]
  extensionPairingCodes    ExtensionPairingCode[]
  extensionConnectRequests ExtensionConnectRequest[]
  subscription             Subscription?
  addOnSubscriptions       AddOnSubscription[]
  payments                 Payment[]
  aiConversations          AiConversation[]
  aiUsage                  AiUsage[]
  notifications            Notification[]
  auditLogs                AuditLog[]

  companyMemberships CompanyMember[]
  companyFollows     CompanyFollower[]

  sentConnections     Connection[]         @relation("ConnectionRequester")
  receivedConnections Connection[]         @relation("ConnectionRecipient")
  following           Follow[]             @relation("UserFollower")
  followers           Follow[]             @relation("UserFollowing")
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  circleMemberships   CircleMember[]
  conversationMembers ConversationMember[]
  messages            Message[]

  @@index([email])
  @@map("users")
}

// Session tokens are DB-backed: the cookie holds an opaque token, only its
// SHA-256 hash is stored, so a leaked DB row can't be replayed as a cookie.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Fine-grained RBAC on top of the coarse UserRole, used for company-scoped
// permission checks (e.g. who on an employer team can publish jobs).
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ============================================================
// CANDIDATE PROFILE / CAREER PROFILE
// ============================================================

enum CareerLevel {
  ENTRY
  ASSOCIATE
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum SponsorshipStatus {
  NOT_REQUIRED
  REQUIRED
  MAY_REQUIRE_FUTURE
}

model CandidateProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  location String?
  headline String?
  bio      String?

  // Professional
  currentTitle         String?
  currentCompany       String?
  totalExperienceYears Float?
  careerLevel          CareerLevel?
  industry             String?

  // Job preferences
  desiredTitles     String[]
  desiredIndustries String[]
  desiredLocations  String[]
  workplaceTypes    WorkplaceType[]
  employmentTypes   EmploymentType[]
  desiredSalaryMin  Int?
  desiredSalaryMax  Int?
  salaryCurrency    String           @default("USD")
  noticePeriodDays  Int?

  // Work authorization
  workAuthorization String?
  sponsorshipStatus SponsorshipStatus @default(NOT_REQUIRED)
  willingToRelocate Boolean           @default(false)

  // Career goals
  targetTitles    String[]
  targetCompanies String[]
  careerGoals     String?

  // Links
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?

  // Scoring (recomputed from real data, never hand-set)
  careerReadinessScore Int @default(0)
  resumeScore          Int @default(0)
  profileScore         Int @default(0)
  skillsScore          Int @default(0)
  interviewScore       Int @default(0)
  jobMatchScore        Int @default(0)

  onboardingCompletedAt DateTime?
  onboardingStep        Int       @default(0)

  visibility ProfileVisibility @default(PRIVATE_UNTIL_APPLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences          WorkExperience[]
  education            Education[]
  certifications       Certification[]
  languages            CandidateLanguage[]
  skills               CandidateSkill[]
  resumes              Resume[]
  savedJobs            SavedJob[]
  jobMatches           JobMatch[]
  applications         Application[]
  interviewSessions    InterviewSession[]
  learningProgress     LearningProgress[]
  courseLessonProgress CourseLessonProgress[]
  autoApplySettings    AutoApplySettings?
  autoApplyRuns        AutoApplyRun[]

  @@map("candidate_profiles")
}

enum ProfileVisibility {
  PUBLIC
  RECRUITERS_ONLY
  PRIVATE_UNTIL_APPLY
  PRIVATE
}

model WorkExperience {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title        String
  company      String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?
  achievements String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("work_experiences")
}

model Education {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("education")
}

model Certification {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name          String
  issuer        String?
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialUrl String?

  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("certifications")
}

model CandidateLanguage {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  language    String
  proficiency LanguageProficiency @default(CONVERSATIONAL)

  @@index([profileId])
  @@map("candidate_languages")
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

// Global, de-duplicated skill dictionary shared by candidates and jobs.
model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  candidates        CandidateSkill[]
  jobs              JobSkill[]
  learningResources LearningResource[]

  @@map("skills")
}

enum SkillType {
  TECHNICAL
  SOFT
  TOOL
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model CandidateSkill {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  type              SkillType  @default(TECHNICAL)
  level             SkillLevel @default(INTERMEDIATE)
  yearsOfExperience Float?

  createdAt DateTime @default(now())

  @@unique([profileId, skillId])
  @@index([profileId])
  @@map("candidate_skills")
}

// ============================================================
// EMPLOYER / COMPANY
// ============================================================

model EmployerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employer_profiles")
}

model Company {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  logoUrl     String?
  coverUrl    String?
  description String?
  industry    String?
  size        String?
  location    String?
  website     String?
  linkedinUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members   CompanyMember[]
  followers CompanyFollower[]
  jobs      Job[]

  @@index([slug])
  @@map("companies")
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
  MEMBER
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMemberRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model CompanyFollower {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@map("company_followers")
}

// ============================================================
// JOBS (skeleton — expanded in Phase 3)
// ============================================================

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model Job {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title          String
  description    String
  location       String?
  workplaceType  WorkplaceType  @default(ONSITE)
  employmentType EmploymentType @default(FULL_TIME)
  careerLevel    CareerLevel?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String         @default("USD")
  status         JobStatus      @default(OPEN)
  externalUrl    String?
  externalId     String?
  source         String         @default("careeros")
  /**
   * Past this, the listing auto-closes — a real, non-cron way of keeping
   * "no longer available" honest without needing the employer (or an
   * external board) to ever tell us it filled.
   */
  expiresAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  skills            JobSkill[]
  savedBy           SavedJob[]
  matches           JobMatch[]
  applications      Application[]
  resumeScores      ResumeScore[]
  interviewSessions InterviewSession[]
  targetedResumes   Resume[]           @relation("ResumeTargetJob")
  posts             Post[]

  @@unique([source, externalId])
  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

model JobSkill {
  id       String  @id @default(cuid())
  jobId    String
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  required Boolean @default(true)

  @@unique([jobId, skillId])
  @@map("job_skills")
}

model SavedJob {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([profileId, jobId])
  @@index([profileId])
  @@map("saved_jobs")
}

// Cached output of the matching engine (src/lib/matching/engine.ts) for a
// profile/job pair, refreshed whenever either side changes materially.
model JobMatch {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  score           Int
  skillsScore     Int
  titleScore      Int
  experienceScore Int
  locationScore   Int
  salaryScore     Int
  matchedSkills   String[]
  missingSkills   String[]
  reasons         String[]

  computedAt DateTime @default(now())

  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("job_matches")
}

// ============================================================
// RESUME (skeleton — expanded in Phase 4)
// ============================================================

model Resume {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name      String
  isPrimary Boolean @default(false)
  content   Json

  /**
   * The live job this resume is being tailored against, if any — read
   * fresh at request time so a closed/filled target is never stale.
   */
  targetJobId String?
  targetJob   Job?    @relation("ResumeTargetJob", fields: [targetJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  scores       ResumeScore[]

  @@index([profileId])
  @@index([targetJobId])
  @@map("resumes")
}

model ResumeScore {
  id       String  @id @default(cuid())
  resumeId String
  resume   Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId    String?
  job      Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  score           Int
  keywordScore    Int
  formatScore     Int
  matchedKeywords String[]
  missingKeywords String[]
  recommendations String[]

  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("resume_scores")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE
  JOB_MATCH
  APPLICATION_UPDATE
  RECRUITER_CONTACT
  INTERVIEW_REMINDER
  LEARNING_RECOMMENDATION
  RESUME_RECOMMENDATION
  SUBSCRIPTION
  AUTO_APPLY_NEEDS_ATTENTION
  SYSTEM
}

model Notification {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     NotificationType
  title    String
  body     String?
  linkUrl  String?
  readAt   DateTime?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}

// ============================================================
// CHROME EXTENSION
// ============================================================

model ExtensionSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  deviceLabel String?
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("extension_sessions")
}

// Manual 6-character pairing code, generated by an already-logged-in user on
// the web app and typed into the extension's options page once.
model ExtensionPairingCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("extension_pairing_codes")
}

enum ExtensionConnectStatus {
  PENDING
  APPROVED
  DENIED
}

// One-click "Sign in" flow: the extension opens a tab at /extension-connect,
// the already-authenticated user approves it there, and the extension polls
// for the result. `pendingToken` holds the raw session token only between
// approval and the first successful poll — it is cleared immediately after.
model ExtensionConnectRequest {
  id           String                 @id @default(cuid())
  state        String                 @unique
  status       ExtensionConnectStatus @default(PENDING)
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String?
  version      String?
  pendingToken String?
  expiresAt    DateTime
  createdAt    DateTime               @default(now())

  @@index([state])
  @@map("extension_connect_requests")
}

// ============================================================
// APPLICATIONS
// ============================================================

enum ApplicationStatus {
  SAVED
  APPLIED
  VIEWED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  MANUAL
  ASSISTED
  AUTO
  EXTENSION
}

model Application {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId  String?
  resume    Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  status            ApplicationStatus @default(APPLIED)
  source            ApplicationSource @default(MANUAL)
  coverLetter       String?
  answers           Json?
  matchScoreAtApply Int?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ApplicationEvent[]

  @@unique([profileId, jobId])
  @@index([profileId])
  @@index([jobId])
  @@index([status])
  @@map("applications")
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  note       String?
  createdAt  DateTime           @default(now())

  @@index([applicationId])
  @@map("application_events")
}

// ============================================================
// BILLING — plans and their features/entitlements are defined in
// src/lib/billing/plans.ts (the single source of truth); these tables
// hold each user's actual PayPal-synced subscription state.
// ============================================================

enum PlanKey {
  BASIC
  STANDARD
  PREMIUM
  ELITE
}

enum AddOnKey {
  RESUME_STUDIO
  INTERVIEW_AI
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   PlanKey
  status SubscriptionStatus @default(INCOMPLETE)

  paypalSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model AddOnSubscription {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addOn  AddOnKey

  status SubscriptionStatus @default(INCOMPLETE)

  paypalSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, addOn])
  @@map("addon_subscriptions")
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paypalTransactionId String? @unique
  amount              Int
  currency            String  @default("usd")
  status              String
  description         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("payments")
}

// ============================================================
// AI — Job GPT persistent chat + usage log. Interview AI (Phase 9) gets
// its own dedicated session/question/answer/score tables rather than
// reusing these, since a scored interview isn't a free-form chat.
// ============================================================

enum AiConversationKind {
  JOB_GPT
}

model AiConversation {
  id     String             @id @default(cuid())
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   AiConversationKind @default(JOB_GPT)
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AiUsage {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature  String
  provider String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("ai_usage")
}

// ============================================================
// INTERVIEW AI — adaptive mock-interview sessions, scored per answer.
// ============================================================

enum InterviewType {
  BEHAVIORAL
  TECHNICAL
  MIXED
}

enum InterviewSessionStatus {
  IN_PROGRESS
  COMPLETED
}

model InterviewSession {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  type         InterviewType          @default(MIXED)
  status       InterviewSessionStatus @default(IN_PROGRESS)
  overallScore Int?
  summary      String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  questions InterviewQuestion[]

  @@index([profileId])
  @@map("interview_sessions")
}

model InterviewQuestion {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  order    Int
  category String
  question String

  answer       String?
  score        Int?
  feedback     String?
  strengths    String[]
  improvements String[]
  answeredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("interview_questions")
}

// ============================================================
// AUTO APPLY — settings + live run tracking for the browser extension's
// automation engine. The extension holds the actual queue/state locally;
// these tables exist so the web Control Center can show real settings and
// a real live run rather than a static mock.
// ============================================================

model AutoApplySettings {
  id        String           @id @default(cuid())
  profileId String           @unique
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  minMatchScore Int     @default(70)
  monthlyLimit  Int     @default(20)
  pacingSeconds Int     @default(45)
  concurrency   Int     @default(1)
  autoSubmit    Boolean @default(false)
  platformModes Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auto_apply_settings")
}

model AutoApplyRun {
  id        String           @id @default(cuid())
  runId     String           @unique
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status    String
  queued    Int     @default(0)
  submitted Int     @default(0)
  assisted  Int     @default(0)
  skipped   Int     @default(0)
  failed    Int     @default(0)
  lastError String?

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("auto_apply_runs")
}

// ============================================================
// LEARNING HUB — a curated catalog of real external resources
// (official docs, free courses), recommended from the candidate's
// actual missing skills as surfaced by the matching engine.
// ============================================================

enum LearningResourceType {
  COURSE
  ARTICLE
  VIDEO
  DOCS
  BOOK
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model LearningResource {
  id       String               @id @default(cuid())
  title    String
  provider String
  url      String
  type     LearningResourceType
  level    LearningLevel        @default(BEGINNER)

  durationMinutes Int?
  description     String

  skillId String?
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  progress LearningProgress[]

  @@index([skillId])
  @@map("learning_resources")
}

enum LearningProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model LearningProgress {
  id         String           @id @default(cuid())
  profileId  String
  profile    CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  status      LearningProgressStatus @default(IN_PROGRESS)
  startedAt   DateTime               @default(now())
  completedAt DateTime?

  @@unique([profileId, resourceId])
  @@index([profileId])
  @@map("learning_progress")
}

// ============================================================
// COURSES — real, hosted, original written lessons Career OS
// authors and owns (vs. LearningResource above, which links out to
// third-party docs/courses). Gated behind the same `learning`
// entitlement as the resource catalog.
// ============================================================

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  category    String
  level       LearningLevel @default(BEGINNER)
  order       Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons CourseLesson[]

  @@index([category])
  @@map("courses")
}

model CourseLesson {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title           String
  /**
   * Original written lesson content: an array of structured Slide objects
   * (see src/lib/learning/slide-types.ts), rendered by a slide-deck player
   * rather than a single scrolling markdown block.
   */
  slides          Json
  order           Int
  durationMinutes Int    @default(5)

  progress CourseLessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("course_lessons")
}

model CourseLessonProgress {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  @@unique([profileId, lessonId])
  @@index([profileId])
  @@map("course_lesson_progress")
}

// ============================================================
// CAREER CIRCLES — network, posts, messaging
// ============================================================

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, recipientId])
  @@index([recipientId])
  @@index([requesterId])
  @@map("connections")
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Circle {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  category    String

  createdAt DateTime @default(now())

  members CircleMember[]
  posts   Post[]

  @@index([category])
  @@map("circles")
}

enum CircleMemberRole {
  MEMBER
  ADMIN
}

model CircleMember {
  id       String           @id @default(cuid())
  circleId String
  circle   Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CircleMemberRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([circleId, userId])
  @@index([userId])
  @@map("circle_members")
}

model Post {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String

  /**
   * Set when this post was made inside a Circle rather than the general feed.
   */
  circleId String?
  circle   Circle? @relation(fields: [circleId], references: [id], onDelete: SetNull)
  /**
   * Set when an employer shares a real open role as a "hiring" post.
   */
  jobId    String?
  job      Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  comments  Comment[]
  reactions Reaction[]

  @@index([authorId])
  @@index([circleId])
  @@map("posts")
}

model Comment {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("comments")
}

model Reaction {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("reactions")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}
