generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & RBAC
// ============================================================

enum UserRole {
  CANDIDATE
  EMPLOYER
  COMPANY_ADMIN
  PLATFORM_ADMIN
  /**
   * Refers candidates into a company's open Bounty (Phase 5 — Earn). Not
   * necessarily a job seeker on the platform, so kept separate from
   * CANDIDATE rather than overloading it.
   */
  REFERRER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  phone         String?
  /// Null for accounts that only ever signed in with Google.
  passwordHash  String?
  /// Links the account to its Google identity (Sign in with Google).
  googleId      String?       @unique
  firstName     String
  lastName      String
  role          UserRole      @default(CANDIDATE)
  status        AccountStatus @default(ACTIVE)
  avatarUrl     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions                 Session[]
  verificationTokens       VerificationToken[]
  passwordResets           PasswordResetToken[]
  candidateProfile         CandidateProfile?
  employerProfile          EmployerProfile?
  extensionSessions        ExtensionSession[]
  extensionPairingCodes    ExtensionPairingCode[]
  extensionConnectRequests ExtensionConnectRequest[]
  subscription             Subscription?
  addOnSubscriptions       AddOnSubscription[]
  payments                 Payment[]
  aiConversations          AiConversation[]
  aiUsage                  AiUsage[]
  notifications            Notification[]
  auditLogs                AuditLog[]

  companyMemberships CompanyMember[]
  companyFollows     CompanyFollower[]

  sentConnections     Connection[]         @relation("ConnectionRequester")
  receivedConnections Connection[]         @relation("ConnectionRecipient")
  following           Follow[]             @relation("UserFollower")
  followers           Follow[]             @relation("UserFollowing")
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  circleMemberships   CircleMember[]
  conversationMembers ConversationMember[]
  messages            Message[]

  referralsMade     Referral[] @relation("ReferralsMade")
  referralsReceived Referral[] @relation("ReferralsReceived")
  payouts           Payout[]

  careersPublisher CareersPublisher?

  @@index([email])
  @@map("users")
}

// Session tokens are DB-backed: the cookie holds an opaque token, only its
// SHA-256 hash is stored, so a leaked DB row can't be replayed as a cookie.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Fine-grained RBAC on top of the coarse UserRole, used for company-scoped
// permission checks (e.g. who on an employer team can publish jobs).
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ============================================================
// CANDIDATE PROFILE / CAREER PROFILE
// ============================================================

enum CareerLevel {
  ENTRY
  ASSOCIATE
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum SponsorshipStatus {
  NOT_REQUIRED
  REQUIRED
  MAY_REQUIRE_FUTURE
}

model CandidateProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  location String?
  headline String?
  bio      String?
  coverUrl String?

  // Professional
  currentTitle         String?
  currentCompany       String?
  totalExperienceYears Float?
  careerLevel          CareerLevel?
  industry             String?

  // Job preferences
  desiredTitles              String[]
  desiredIndustries          String[]
  desiredLocations           String[]
  /// Radius in miles around desiredLocations[0] to treat as "close enough" —
  /// only meaningful when the location resolves in lib/geo/cities.ts; unset
  /// (null) keeps the previous substring-only location matching.
  desiredLocationRadiusMiles Int?
  workplaceTypes             WorkplaceType[]
  employmentTypes            EmploymentType[]
  desiredSalaryMin           Int?
  desiredSalaryMax           Int?
  salaryCurrency             String           @default("USD")
  noticePeriodDays           Int?

  // Work authorization
  workAuthorization String?
  sponsorshipStatus SponsorshipStatus @default(NOT_REQUIRED)
  willingToRelocate Boolean           @default(false)

  // Career goals
  targetTitles    String[]
  targetCompanies String[]
  careerGoals     String?

  // Links
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?

  // Scoring (recomputed from real data, never hand-set)
  careerReadinessScore Int @default(0)
  resumeScore          Int @default(0)
  profileScore         Int @default(0)
  skillsScore          Int @default(0)
  interviewScore       Int @default(0)
  jobMatchScore        Int @default(0)

  onboardingCompletedAt DateTime?
  onboardingStep        Int       @default(0)

  visibility ProfileVisibility @default(PRIVATE_UNTIL_APPLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences          WorkExperience[]
  education            Education[]
  certifications       Certification[]
  languages            CandidateLanguage[]
  skills               CandidateSkill[]
  resumes              Resume[]
  savedJobs            SavedJob[]
  jobMatches           JobMatch[]
  applications         Application[]
  interviewSessions    InterviewSession[]
  interviewStories     InterviewStory[]
  interviewPrepPacks   InterviewPrepPack[]
  learningProgress     LearningProgress[]
  courseLessonProgress CourseLessonProgress[]
  autoApplySettings    AutoApplySettings?
  autoApplyRuns        AutoApplyRun[]
  toolkitOutputs       ToolkitOutput[]
  extensionAnswers     ExtensionAnswer[]

  resumeUnlocks      ResumeUnlock[]
  atsScreenings      AtsScreening[]
  jobEvaluations     JobEvaluation[]
  negotiationScripts NegotiationScript[]
  outreachDrafts     OutreachDraft[]

  @@map("candidate_profiles")
}

enum ProfileVisibility {
  PUBLIC
  RECRUITERS_ONLY
  PRIVATE_UNTIL_APPLY
  PRIVATE
}

model WorkExperience {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title        String
  company      String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?
  achievements String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("work_experiences")
}

model Education {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("education")
}

model Certification {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name          String
  issuer        String?
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialUrl String?

  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("certifications")
}

model CandidateLanguage {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  language    String
  proficiency LanguageProficiency @default(CONVERSATIONAL)

  @@index([profileId])
  @@map("candidate_languages")
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

// Global, de-duplicated skill dictionary shared by candidates and jobs.
model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  candidates        CandidateSkill[]
  jobs              JobSkill[]
  learningResources LearningResource[]

  @@map("skills")
}

enum SkillType {
  TECHNICAL
  SOFT
  TOOL
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model CandidateSkill {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  type              SkillType  @default(TECHNICAL)
  level             SkillLevel @default(INTERMEDIATE)
  yearsOfExperience Float?

  createdAt DateTime @default(now())

  @@unique([profileId, skillId])
  @@index([profileId])
  @@map("candidate_skills")
}

// ============================================================
// EMPLOYER / COMPANY
// ============================================================

model EmployerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employer_profiles")
}

model Company {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  logoUrl     String?
  coverUrl    String?
  description String?
  industry    String?
  size        String?
  location    String?
  website     String?
  linkedinUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members   CompanyMember[]
  followers CompanyFollower[]
  jobs      Job[]
  bounties  Bounty[]

  enterpriseAccount EnterpriseAccount?

  @@index([slug])
  @@map("companies")
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
  MEMBER
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMemberRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model CompanyFollower {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@map("company_followers")
}

// ============================================================
// JOBS (skeleton — expanded in Phase 3)
// ============================================================

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model Job {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title          String
  description    String
  location       String?
  workplaceType  WorkplaceType  @default(ONSITE)
  employmentType EmploymentType @default(FULL_TIME)
  careerLevel    CareerLevel?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String         @default("USD")
  status         JobStatus      @default(OPEN)
  externalUrl    String?
  externalId     String?
  source         String         @default("careeros")
  /**
   * Past this, the listing auto-closes — a real, non-cron way of keeping
   * "no longer available" honest without needing the employer (or an
   * external board) to ever tell us it filled.
   */
  expiresAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  skills             JobSkill[]
  savedBy            SavedJob[]
  matches            JobMatch[]
  applications       Application[]
  resumeScores       ResumeScore[]
  interviewSessions  InterviewSession[]
  interviewPrepPacks InterviewPrepPack[]
  targetedResumes    Resume[]            @relation("ResumeTargetJob")
  toolkitOutputs     ToolkitOutput[]
  bounties           Bounty[]

  enterprisePost     EnterpriseJobPost?
  atsScreenings      AtsScreening[]
  posts              Post[]
  evaluations        JobEvaluation[]
  negotiationScripts NegotiationScript[]
  outreachDrafts     OutreachDraft[]

  @@unique([source, externalId])
  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

model JobSkill {
  id       String  @id @default(cuid())
  jobId    String
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  required Boolean @default(true)

  @@unique([jobId, skillId])
  @@map("job_skills")
}

model SavedJob {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([profileId, jobId])
  @@index([profileId])
  @@map("saved_jobs")
}

// Cached output of the matching engine (src/lib/matching/engine.ts) for a
// profile/job pair, refreshed whenever either side changes materially.
model JobMatch {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  score           Int
  skillsScore     Int
  titleScore      Int
  experienceScore Int
  locationScore   Int
  salaryScore     Int
  matchedSkills   String[]
  missingSkills   String[]
  reasons         String[]

  computedAt DateTime @default(now())

  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("job_matches")
}

// ============================================================
// RESUME (skeleton — expanded in Phase 4)
// ============================================================

model Resume {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name      String
  isPrimary Boolean @default(false)
  content   Json

  /**
   * The live job this resume is being tailored against, if any — read
   * fresh at request time so a closed/filled target is never stale.
   */
  targetJobId String?
  targetJob   Job?    @relation("ResumeTargetJob", fields: [targetJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  scores       ResumeScore[]

  @@index([profileId])
  @@index([targetJobId])
  @@map("resumes")
}

model ResumeScore {
  id       String  @id @default(cuid())
  resumeId String
  resume   Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId    String?
  job      Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  score           Int
  keywordScore    Int
  formatScore     Int
  matchedKeywords String[]
  missingKeywords String[]
  recommendations String[]

  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("resume_scores")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE
  JOB_MATCH
  APPLICATION_UPDATE
  RECRUITER_CONTACT
  INTERVIEW_REMINDER
  LEARNING_RECOMMENDATION
  RESUME_RECOMMENDATION
  SUBSCRIPTION
  AUTO_APPLY_NEEDS_ATTENTION
  SYSTEM
}

model Notification {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     NotificationType
  title    String
  body     String?
  linkUrl  String?
  readAt   DateTime?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}

// ============================================================
// CHROME EXTENSION
// ============================================================

model ExtensionSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  deviceLabel String?
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("extension_sessions")
}

// Manual 6-character pairing code, generated by an already-logged-in user on
// the web app and typed into the extension's options page once.
model ExtensionPairingCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("extension_pairing_codes")
}

enum ExtensionConnectStatus {
  PENDING
  APPROVED
  DENIED
}

// One-click "Sign in" flow: the extension opens a tab at /extension-connect,
// the already-authenticated user approves it there, and the extension polls
// for the result. `pendingToken` holds the raw session token only between
// approval and the first successful poll — it is cleared immediately after.
model ExtensionConnectRequest {
  id           String                 @id @default(cuid())
  state        String                 @unique
  status       ExtensionConnectStatus @default(PENDING)
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String?
  version      String?
  pendingToken String?
  expiresAt    DateTime
  createdAt    DateTime               @default(now())

  @@index([state])
  @@map("extension_connect_requests")
}

// ============================================================
// APPLICATIONS
// ============================================================

enum ApplicationStatus {
  SAVED
  APPLIED
  VIEWED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  MANUAL
  ASSISTED
  AUTO
  EXTENSION
}

model Application {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId  String?
  resume    Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  status            ApplicationStatus @default(APPLIED)
  source            ApplicationSource @default(MANUAL)
  coverLetter       String?
  answers           Json?
  matchScoreAtApply Int?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   ApplicationEvent[]
  prepPack InterviewPrepPack?

  @@unique([profileId, jobId])
  @@index([profileId])
  @@index([jobId])
  @@index([status])
  @@map("applications")
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  note       String?
  createdAt  DateTime           @default(now())

  @@index([applicationId])
  @@map("application_events")
}

// ============================================================
// BILLING — plans and their features/entitlements are defined in
// src/lib/billing/plans.ts (the single source of truth); these tables
// hold each user's actual PayPal-synced subscription state.
// ============================================================

enum PlanKey {
  BASIC
  STANDARD
  PREMIUM
  ELITE
}

enum AddOnKey {
  RESUME_STUDIO
  INTERVIEW_AI
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   PlanKey
  status SubscriptionStatus @default(INCOMPLETE)

  paypalSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model AddOnSubscription {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addOn  AddOnKey

  status SubscriptionStatus @default(INCOMPLETE)

  paypalSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, addOn])
  @@map("addon_subscriptions")
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paypalTransactionId String? @unique
  amount              Int
  currency            String  @default("usd")
  status              String
  description         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("payments")
}

// ============================================================
// AI — Job GPT persistent chat + usage log. Interview AI (Phase 9) gets
// its own dedicated session/question/answer/score tables rather than
// reusing these, since a scored interview isn't a free-form chat.
// ============================================================

enum AiConversationKind {
  JOB_GPT
}

model AiConversation {
  id     String             @id @default(cuid())
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   AiConversationKind @default(JOB_GPT)
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AiUsage {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature  String
  provider String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("ai_usage")
}

// ============================================================
// INTERVIEW AI — adaptive mock-interview sessions, scored per answer.
// ============================================================

enum InterviewType {
  BEHAVIORAL
  TECHNICAL
  MIXED
}

enum InterviewSessionStatus {
  IN_PROGRESS
  COMPLETED
}

model InterviewSession {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Set when the practice is for a paid AI-work role (see AiWorkRole).
  aiWorkRoleId String?
  aiWorkRole   AiWorkRole? @relation(fields: [aiWorkRoleId], references: [id], onDelete: SetNull)

  type         InterviewType          @default(MIXED)
  status       InterviewSessionStatus @default(IN_PROGRESS)
  overallScore Int?
  summary      String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  questions InterviewQuestion[]

  @@index([profileId])
  @@index([jobId])
  @@map("interview_sessions")
}

model InterviewQuestion {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  order    Int
  category String
  question String

  answer       String?
  score        Int?
  feedback     String?
  strengths    String[]
  improvements String[]
  answeredAt   DateTime?
  /**
   * How many times this question has been (re)scored — 0 means the initial
   * answer only. A retry re-scores the same question in place instead of
   * advancing the session, distinct from the normal linear flow.
   */
  attempts     Int       @default(0)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("interview_questions")
}

// ============================================================
// PREPARE — an auto-generated "prep pack" for one job application, built the
// moment its Application reaches INTERVIEW status (see
// updateApplicationStatusForCompany in src/lib/employer/applications.ts) and
// reused across every Practice session and the Applications page, rather
// than regenerated on every view. See src/lib/interview/prep.ts.
// ============================================================

model InterviewPrepPack {
  id            String           @id @default(cuid())
  applicationId String           @unique
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  profileId     String
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /**
   * A few sentences pulled from the real Job/Company records — never fabricated.
   */
  companyBrief String

  /**
   * GeneratedQuestion[] — likely interview questions for this role.
   */
  questions Json

  /**
   * PrepStory[] — 5-6 STAR-format stories grounded in the candidate's real history.
   */
  stories Json

  /**
   * 3-4 good questions the candidate could ask the interviewer.
   */
  questionsToAsk String[]

  /**
   * 0-100, distinct from CandidateProfile.interviewScore — how ready this
   * candidate is for THIS job specifically, computed from practice
   * performance against this pack. Recomputed after each completed
   * practice session tied to this job (see recomputeJobReadiness).
   */
  readinessScore     Int       @default(0)
  readinessUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("interview_prep_packs")
}

// ============================================================
// MY STORIES — a locked personal answer bank for the handful of core
// behavioral questions almost every interview asks. The candidate practices
// each with the same AI coach that scores mock-interview answers (see
// scoreAnswer in src/lib/interview/service.ts), then "locks" one final
// wording they've approved — surfaced in the standalone practice-only
// `interview-extension/` companion extension alongside mock interviews.
// ============================================================

model InterviewStory {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /**
   * One of CORE_STORY_QUESTIONS in src/lib/interview/stories.ts.
   */
  question String

  answer       String?
  score        Int?
  feedback     String?
  strengths    String[]
  improvements String[]

  /**
   * Null until the candidate explicitly approves a final wording.
   */
  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, question])
  @@map("interview_stories")
}

// ============================================================
// AUTO APPLY — settings + live run tracking for the browser extension's
// automation engine. The extension holds the actual queue/state locally;
// these tables exist so the web Control Center can show real settings and
// a real live run rather than a static mock.
// ============================================================

model AutoApplySettings {
  id        String           @id @default(cuid())
  profileId String           @unique
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  minMatchScore Int     @default(70)
  monthlyLimit  Int     @default(20)
  pacingSeconds Int     @default(45)
  concurrency   Int     @default(1)
  autoSubmit    Boolean @default(true)
  platformModes Json    @default("{}")

  /// "start" or "stop" pressed on the Auto Apply page, waiting for the extension to pick it up.
  runCommand   String?
  runCommandAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auto_apply_settings")
}

/// Answers the candidate gave on application forms (typed by them, or AI drafts they kept), reused by the
/// extension on later forms that ask the same or a similar question. Keys starting "eeo:" hold the meaning
/// of a self-identification answer (e.g. eeo:veteran = "No"), so any wording of that question matches.
model ExtensionAnswer {
  id          String           @id @default(cuid())
  profileId   String
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  questionKey String
  question    String
  answer      String
  source      String           @default("user")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([profileId, questionKey])
  @@map("extension_answers")
}

model AutoApplyRun {
  id        String           @id @default(cuid())
  runId     String           @unique
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status    String
  queued    Int     @default(0)
  submitted Int     @default(0)
  assisted  Int     @default(0)
  skipped   Int     @default(0)
  failed    Int     @default(0)
  lastError String?
  /// Applications waiting in a browser tab for the person (CAPTCHA, sign-in, a question): [{title, company, url, reason, message, since}]
  waiting   Json    @default("[]")

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("auto_apply_runs")
}

// ============================================================
// EXTENSION SELECTOR OVERRIDES — a single admin-editable row the extension
// polls so a DOM change on an ATS can be patched without a store release.
// Kept as one JSON blob rather than a table per selector: the shape mirrors
// extension/lib/ats.js's ADAPTERS entries exactly, and a single row is all a
// first version needs (see src/app/api/admin/extension/selectors and
// src/app/api/extension/selectors).
// ============================================================

model ExtensionSelectorOverride {
  /**
   * Always "singleton" — one row holds every adapter's overrides.
   */
  id String @id @default("singleton")

  /**
   * { [atsId]: { form?, submit?, title?, company?, description? } }
   */
  overrides Json @default("{}")

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("extension_selector_overrides")
}

// ============================================================
// LEARNING HUB — a curated catalog of real external resources
// (official docs, free courses), recommended from the candidate's
// actual missing skills as surfaced by the matching engine.
// ============================================================

enum LearningResourceType {
  COURSE
  ARTICLE
  VIDEO
  DOCS
  BOOK
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model LearningResource {
  id       String               @id @default(cuid())
  title    String
  provider String
  url      String
  type     LearningResourceType
  level    LearningLevel        @default(BEGINNER)

  durationMinutes Int?
  description     String

  skillId String?
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  progress LearningProgress[]

  @@index([skillId])
  @@map("learning_resources")
}

enum LearningProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model LearningProgress {
  id         String           @id @default(cuid())
  profileId  String
  profile    CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  status      LearningProgressStatus @default(IN_PROGRESS)
  startedAt   DateTime               @default(now())
  completedAt DateTime?

  @@unique([profileId, resourceId])
  @@index([profileId])
  @@map("learning_progress")
}

// ============================================================
// COURSES — real, hosted, original written lessons Career OS
// authors and owns (vs. LearningResource above, which links out to
// third-party docs/courses). Gated behind the same `learning`
// entitlement as the resource catalog.
// ============================================================

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  category    String
  level       LearningLevel @default(BEGINNER)
  order       Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons CourseLesson[]

  @@index([category])
  @@map("courses")
}

model CourseLesson {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title           String
  /**
   * Original written lesson content: an array of structured Slide objects
   * (see src/lib/learning/slide-types.ts), rendered by a slide-deck player
   * rather than a single scrolling markdown block.
   */
  slides          Json
  order           Int
  durationMinutes Int    @default(5)

  progress CourseLessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("course_lessons")
}

model CourseLessonProgress {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  @@unique([profileId, lessonId])
  @@index([profileId])
  @@map("course_lesson_progress")
}

// ============================================================
// CAREER CIRCLES — network, posts, messaging
// ============================================================

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, recipientId])
  @@index([recipientId])
  @@index([requesterId])
  @@map("connections")
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Circle {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  category    String

  createdAt DateTime @default(now())

  members CircleMember[]
  posts   Post[]

  @@index([category])
  @@map("circles")
}

enum CircleMemberRole {
  MEMBER
  ADMIN
}

model CircleMember {
  id       String           @id @default(cuid())
  circleId String
  circle   Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CircleMemberRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([circleId, userId])
  @@index([userId])
  @@map("circle_members")
}

model Post {
  id       String   @id @default(cuid())
  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String
  kind     PostKind @default(GENERAL)

  /**
   * An uploaded image, stored as a data: URL — see src/lib/upload/image.ts.
   */
  imageUrl String?
  /**
   * An external video link (YouTube/Vimeo/Loom) shown as an embed.
   */
  videoUrl String?

  /**
   * Set when this post was made inside a Circle rather than the general feed.
   */
  circleId String?
  circle   Circle? @relation(fields: [circleId], references: [id], onDelete: SetNull)
  /**
   * Set when an employer shares a real open role as a "hiring" post.
   */
  jobId    String?
  job      Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /**
   * Set when this post is a repost of another — content holds the reposter's
   * own added commentary, if any (may be empty). onDelete: Cascade because a
   * repost with its original gone is meaningless, unlike circle/job which
   * degrade gracefully to SetNull.
   */
  repostOfId String?
  repostOf   Post?   @relation("PostRepost", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts    Post[]  @relation("PostRepost")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  comments  Comment[]
  reactions Reaction[]

  boosts Boost[]

  @@index([authorId])
  @@index([circleId])
  @@index([repostOfId])
  @@map("posts")
}

model Comment {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("comments")
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

model Reaction {
  id     String       @id @default(cuid())
  postId String
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   ReactionType @default(LIKE)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("reactions")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ============================================================
// AI TOOLKIT — persisted output of each AI Toolkit generator run
// (Cover Letter, Email, Question Response, Resume Review — Phase 2).
// Mirrors ResumeScore's "timestamped, never-mutated snapshot" pattern:
// every generation is its own row, so a candidate can see/reuse past
// outputs rather than only the most recent one.
// ============================================================

enum ToolkitType {
  COVER_LETTER
  EMAIL
  QUESTION_RESPONSE
  RESUME_REVIEW
}

model ToolkitOutput {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type ToolkitType

  /**
   * The job this output was generated for, if any (cover letters/emails
   * are usually job-specific; a resume review may not be).
   */
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /**
   * Free-form input the candidate supplied beyond their Career Profile
   * (e.g. a pasted question to respond to, a recipient name for an email).
   * Never used to invent facts — only Career Profile + Job data is
   * grounding; this is prompt input, not a source of truth.
   */
  input Json?

  /**
   * The generated body.
   */
  output String

  /**
   * Which AI provider actually served this call — kept here too since
   * AiUsage rows are not queryable per-output.
   */
  provider String

  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([profileId, type])
  @@index([jobId])
  @@map("toolkit_outputs")
}

// ============================================================
// EARN — referral bounties (Phase 5). Ships only with the user's explicit
// confirmation per docs/ROADMAP.md's payments + consent gates — bounty/
// payout tables underpin a real payments feature.
// ============================================================

enum BountyStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

model Bounty {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String? // optional: a bounty can target a specific open Job
  job       Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  title               String
  description         String
  status              BountyStatus @default(DRAFT)
  amountCents         Int
  currency            String       @default("USD")
  /**
   * Paid once the referred candidate reaches INTERVIEW (or similar).
   */
  interviewBonusCents Int          @default(0)
  /**
   * Paid after the post-hire guarantee period.
   */
  hireBonusCents      Int          @default(0)
  guaranteeDays       Int          @default(90)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  referrals Referral[]
  payouts   Payout[]

  @@index([companyId])
  @@index([status])
  @@map("bounties")
}

enum ReferralStatus {
  PENDING_CONSENT // candidate consent email sent, not yet confirmed
  CONSENTED
  SUBMITTED // visible to employer
  INTERVIEWING
  HIRED
  REJECTED
  WITHDRAWN
}

model Referral {
  id       String @id @default(cuid())
  bountyId String
  bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)

  referrerId      String
  referrer        User    @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  /**
   * The person being referred — may not have a CareerOS account yet, so
   * this is captured as plain fields, not a required User relation, until/
   * unless they sign up and the candidate side of the flow links them.
   */
  candidateName   String
  candidateEmail  String
  candidateUserId String?
  candidateUser   User?   @relation("ReferralsReceived", fields: [candidateUserId], references: [id], onDelete: SetNull)

  endorsement String
  status      ReferralStatus @default(PENDING_CONSENT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  consentedAt DateTime?

  payouts Payout[]

  @@index([bountyId])
  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum PayoutTrigger {
  INTERVIEW_REACHED
  HIRE_CONFIRMED
}

model Payout {
  id         String   @id @default(cuid())
  bountyId   String
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrerId String
  referrer   User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  trigger     PayoutTrigger
  amountCents Int
  currency    String        @default("USD")
  status      PayoutStatus  @default(PENDING)

  paypalPayoutId String? @unique

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([bountyId])
  @@index([referrerId])
  @@index([status])
  @@map("payouts")
}

// ============================================================
// FEATURE FLAGS — simple runtime on/off switches, checked by key. No
// per-user targeting beyond an optional rollout percentage; add a proper
// targeting table later if that's ever actually needed instead of
// speculatively building it now.
// ============================================================

model FeatureFlag {
  id             String  @id @default(cuid())
  key            String  @unique
  description    String?
  enabled        Boolean @default(false)
  /**
   * 0-100. When enabled, the flag is also gated by this percentage of
   * users (stable-hashed on userId) — 100 means everyone.
   */
  rolloutPercent Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

// ============================================================
// ENTERPRISE RECRUITER SUITE — paid recruiter subscription for job
// providers (EMPLOYER / COMPANY_ADMIN accounts). Everything hangs off the
// recruiter's Company, which is the tenant boundary: one firm's credits,
// screenings and outreach are never visible to another.
// ============================================================

enum EnterprisePlanKey {
  STARTER
  PROFESSIONAL
}

enum EnterpriseStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  FREE
}

model EnterpriseAccount {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /**
   * Null while on the trial or the free tier.
   */
  plan   EnterprisePlanKey?
  status EnterpriseStatus   @default(FREE)

  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  /**
   * Set once the $199 first month has been used — never offered again.
   */
  introUsedAt DateTime?
  /**
   * True while the current PayPal subscription is still on its $199 cycle.
   */
  introActive Boolean   @default(false)

  paypalSubscriptionId String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      EnterpriseEvent[]
  credits     CreditTransaction[]
  jobPosts    EnterpriseJobPost[]
  unlocks     ResumeUnlock[]
  screenings  AtsScreening[]
  outreach    OutreachMessage[]
  boosts      Boost[]
  boostOrders BoostOrder[]

  @@map("enterprise_accounts")
}

/**
 * Subscription history: every state change, payment and plan switch.
 */
model EnterpriseEvent {
  id          String             @id @default(cuid())
  accountId   String
  account     EnterpriseAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actorUserId String?
  type        String
  fromStatus  EnterpriseStatus?
  toStatus    EnterpriseStatus?
  plan        EnterprisePlanKey?
  amountCents Int?
  detail      String?
  createdAt   DateTime           @default(now())

  @@index([accountId, createdAt])
  @@map("enterprise_events")
}

enum CreditKind {
  RESUME_FETCH
  INMAIL
  POST_BOOST
  CAMPAIGN_BOOST
}

/**
 * Append-only credit ledger. A period's balance is the sum of `delta` for
 * that account, kind and periodKey — grants are +N rows written once per
 * billing period, each use is a -1 row. `refKey` makes every write
 * idempotent (the same unlock or send can never be charged twice).
 */
model CreditTransaction {
  id                 String            @id @default(cuid())
  accountId          String
  account            EnterpriseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind               CreditKind
  delta              Int
  /**
   * GRANT | CONSUME | REFUND
   */
  type               String
  periodKey          String
  refKey             String
  actorUserId        String?
  candidateProfileId String?
  jobId              String?
  boostId            String?
  outreachId         String?
  note               String?
  createdAt          DateTime          @default(now())

  @@unique([accountId, kind, refKey])
  @@index([accountId, kind, periodKey])
  @@map("credit_transactions")
}

/**
 * One row per formal job posted, so a deleted job never refunds the day's quota.
 */
model EnterpriseJobPost {
  id         String            @id @default(cuid())
  accountId  String
  account    EnterpriseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  jobId      String            @unique
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /**
   * UTC calendar day, YYYY-MM-DD.
   */
  dayKey     String
  postedById String
  createdAt  DateTime          @default(now())

  @@index([accountId, dayKey])
  @@map("enterprise_job_posts")
}

/**
 * A candidate's full resume + contact package unlocked by a firm for one billing period.
 */
model ResumeUnlock {
  id                 String            @id @default(cuid())
  accountId          String
  account            EnterpriseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  periodKey          String
  unlockedById       String
  createdAt          DateTime          @default(now())

  @@unique([accountId, candidateProfileId, periodKey])
  @@index([accountId, periodKey])
  @@map("resume_unlocks")
}

enum AtsCategory {
  HIGHLY_QUALIFIED
  QUALIFIED
  POTENTIAL_MATCH
  NOT_SUITABLE
}

model AtsScreening {
  id                 String            @id @default(cuid())
  accountId          String
  account            EnterpriseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String?
  candidateProfile   CandidateProfile? @relation(fields: [candidateProfileId], references: [id], onDelete: SetNull)
  candidateName      String?
  score              Int
  category           AtsCategory
  summary            String
  strengths          String[]
  weaknesses         String[]
  missingSkills      String[]
  recommendations    String[]
  /**
   * Per-criterion scores: skills, experience, education, employment, technical, location, salary, relevance.
   */
  breakdown          Json
  model              String?
  createdById        String
  createdAt          DateTime          @default(now())

  @@index([accountId, jobId])
  @@map("ats_screenings")
}

enum OutreachChannel {
  IN_APP
  EMAIL
}

enum OutreachStatus {
  SENT
  DELIVERED
  FAILED
  REPLIED
}

model OutreachMessage {
  id                String            @id @default(cuid())
  accountId         String
  account           EnterpriseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  senderUserId      String
  targetCompanyId   String?
  targetCompanyName String?
  channel           OutreachChannel
  recipientUserId   String?
  recipientEmail    String?
  subject           String
  body              String
  status            OutreachStatus
  providerMessageId String?
  conversationId    String?
  error             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([accountId, senderUserId, createdAt])
  @@map("outreach_messages")
}

enum BoostKind {
  POST
  CAMPAIGN
}

enum BoostSource {
  FREE
  PAID
}

model Boost {
  id          String            @id @default(cuid())
  accountId   String
  account     EnterpriseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        BoostKind
  source      BoostSource
  name        String?
  postId      String?
  post        Post?             @relation(fields: [postId], references: [id], onDelete: SetNull)
  jobIds      String[]
  startsAt    DateTime          @default(now())
  endsAt      DateTime
  createdById String
  createdAt   DateTime          @default(now())

  order BoostOrder?

  @@index([kind, endsAt])
  @@index([accountId])
  @@map("boosts")
}

/**
 * A pay-as-you-go boost purchase. The PayPal order id is unique, and the boost is created only once, on a confirmed capture.
 */
model BoostOrder {
  id            String            @id @default(cuid())
  accountId     String
  account       EnterpriseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind          BoostKind
  amountCents   Int
  paypalOrderId String            @unique
  /**
   * CREATED | CAPTURED | FAILED
   */
  status        String
  /**
   * What to boost once paid: { postId } or { name, jobIds }.
   */
  payload       Json
  boostId       String?           @unique
  boost         Boost?            @relation(fields: [boostId], references: [id], onDelete: SetNull)
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([accountId])
  @@map("boost_orders")
}

// ============================================================
// CAREER OS CAREERS — the centralized public job board. Only users in
// CareersPublisher may create or change listings; the apply URL is never
// sent to the browser, only followed server-side by /careers/apply/[id].
// ============================================================

model CareersListing {
  id          String    @id @default(cuid())
  title       String
  description String
  applyUrl    String
  published   Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([published, createdAt])
  @@map("careers_listings")
}

model CareersPublisher {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?
  createdAt   DateTime @default(now())

  @@map("careers_publishers")
}

/**
 * Small server-side settings store, e.g. the PayPal plan ids the app creates for itself.
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

enum PostKind {
  GENERAL
  JOB_ANNOUNCEMENT
}

// ============================================================
// CAREER TOOLS (restored from September): per-job fit evaluation with a
// legitimacy check, negotiation scripts, and draft-only outreach.
// ============================================================

enum JobLegitimacy {
  CLEAR
  CAUTION
  LIKELY_SCAM
}

/// A narrative, holistic evaluation of one posting for one candidate —
/// deliberately separate from JobMatch's automatic 0-100 sub-scores, which
/// are cheap and computed for every job. This is an on-demand AI judgement
/// call: a 1-5 fit score, a written case for it, and a legitimacy check
/// that flags scam/ghost postings and an explicit no-sponsorship blocker.
model JobEvaluation {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// 1-5 in tenths (e.g. 4.5 stored as 45), reached by holistic judgement,
  /// not an arithmetic formula.
  score Int

  summary         String
  cvMatchNotes    String
  levelStrategy   String
  compNotes       String
  personalization String
  interviewPrep   String

  legitimacy         JobLegitimacy @default(CLEAR)
  legitimacyNotes    String
  sponsorshipBlocker Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("job_evaluations")
}

/// A generated negotiation script for one scenario (counter-offer,
/// competing-offer leverage, geographic-discount pushback, ...), grounded
/// in the candidate's real desired range and, when tied to a job, that
/// job's posted range and the offer actually on the table.
model NegotiationScript {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  scenario      String
  offeredSalary Int?
  currency      String @default("USD")
  script        String

  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("negotiation_scripts")
}

/// A drafted cold email or LinkedIn message — CareerOS never sends this,
/// it only writes the draft for the candidate to review and send
/// themselves. Contact details are whatever the candidate supplied; this
/// never invents a name, title, or address.
model OutreachDraft {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  channel     String
  contactName String?
  contactRole String?
  subject     String?
  body        String

  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("outreach_drafts")
}

// ============================================================
// AI WORK — paid AI-training roles from partners (micro1), added by
// platform admins. People apply on the partner's site and are paid by the
// partner; Career OS only lists the roles and helps people prepare.
// ============================================================

enum AiWorkRoleStatus {
  ACTIVE
  CLOSED
}

model AiWorkRole {
  id          String           @id @default(cuid())
  partner     String           @default("micro1")
  title       String
  category    String
  description String
  skills      String[]
  minYears    Int?
  /// Hourly pay range in whole units of payCurrency.
  payMin      Int?
  payMax      Int?
  payCurrency String           @default("USD")
  /// The role's page on the partner's site (a referral link when there is one).
  applyUrl    String?
  status      AiWorkRoleStatus @default(ACTIVE)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewSessions InterviewSession[]

  @@index([status, createdAt])
  @@map("ai_work_roles")
}
