{
  "manifest_version": 3,
  "name": "CareerOS — Auto Apply",
  "short_name": "CareerOS",
  "version": "2.5.0",
  "description": "Finds roles that match you and applies on employer sites, filling every form from your Career OS profile. Anything it can’t answer waits for you.",
  "author": "Career OS",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CareerOS",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://careeros.silverspringstaffing.com/*"
  ],
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Open the CareerOS run dashboard"
    }
  },
  "optional_host_permissions": [
    "https://*.greenhouse.io/*",
    "https://boards-api.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://api.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://api.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkday.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.workable.com/*",
    "https://apply.workable.com/*",
    "https://*.smartrecruiters.com/*",
    "https://api.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.bamboohr.com/*",
    "https://*.jazz.co/*",
    "https://*.applytojob.com/*",
    "https://*.jobvite.com/*",
    "https://*.taleo.net/*",
    "https://*.recruitee.com/*",
    "https://*.teamtailor.com/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://smartapply.indeed.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.dice.com/*",
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.co.in/*",
    "https://*.glassdoor.co.uk/*",
    "https://*.monster.com/*",
    "https://api.adzuna.com/*",
    "https://jsearch.p.rapidapi.com/*",
    "https://data.usajobs.gov/*"
  ],
  "homepage_url": "https://careeros.silverspringstaffing.com/",
  "minimum_chrome_version": "102"
}
