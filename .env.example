# Database
DATABASE_URL="postgresql://user:password@localhost:5432/careeros_dev?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-string"

# Email (falls back to console logging in development if unset)
EMAIL_PROVIDER="console" # console | resend | smtp
RESEND_API_KEY=""
EMAIL_FROM="Career OS <no-reply@careeros.app>"

# AI Provider (falls back to a deterministic mock provider in development if unset)
# Leave AI_PROVIDER unset to auto-pick the first configured key below, in this
# order: anthropic -> openrouter -> agentrouter -> openai -> mock.
AI_PROVIDER="" # mock | anthropic | openrouter | agentrouter | openai
AI_MODEL="claude-opus-5" # model id for whichever provider above is primary
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY="" # openrouter.ai — OpenAI-compatible; AI_MODEL e.g. "openai/gpt-5"
AGENTROUTER_API_KEY="" # agentrouter.org — OpenAI-compatible; AI_MODEL e.g. "gpt-5"
OPENAI_API_KEY="" # api.openai.com — also used as the automatic fallback provider
AI_FALLBACK_MODEL="gpt-5" # model id used when a primary call fails and OpenAI is the fallback

# Stripe (billing routes return a clear "not configured" error if unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs — one per plan/add-on, from the Stripe dashboard
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_ELITE=""
STRIPE_PRICE_RESUME_STUDIO=""
STRIPE_PRICE_INTERVIEW_AI=""

# Dev-only: grants entitlements for this plan without a real subscription.
# Ignored entirely when STRIPE_SECRET_KEY is set or NODE_ENV=production.
DEV_GRANT_PLAN="" # BASIC | STANDARD | PREMIUM | ELITE

# Redis (background jobs / queues) - optional in development
REDIS_URL=""

# External job aggregation (admin-triggered sync at /admin -> "Sync external
# job listings", or POST /api/admin/jobs/sync-external). Either or both can
# be set; sources with no key configured are skipped, not errored.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
JSEARCH_API_KEY="" # a RapidAPI key subscribed to the JSearch API
