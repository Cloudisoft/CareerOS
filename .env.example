# Database
DATABASE_URL="postgresql://user:password@localhost:5432/careeros_dev?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-string"

# Email (falls back to console logging in development if unset)
EMAIL_PROVIDER="console" # console | resend | smtp
RESEND_API_KEY=""
EMAIL_FROM="Career OS <no-reply@careeros.app>"

# AI Provider (falls back to a deterministic mock provider in development if unset)
AI_PROVIDER="mock" # mock | anthropic
AI_MODEL="claude-opus-5"
ANTHROPIC_API_KEY=""

# Stripe (billing routes return a clear "not configured" error if unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs — one per plan/add-on, from the Stripe dashboard
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_ELITE=""
STRIPE_PRICE_RESUME_STUDIO=""
STRIPE_PRICE_INTERVIEW_AI=""

# Dev-only: grants entitlements for this plan without a real subscription.
# Ignored entirely when STRIPE_SECRET_KEY is set or NODE_ENV=production.
DEV_GRANT_PLAN="" # BASIC | STANDARD | PREMIUM | ELITE

# Redis (background jobs / queues) - optional in development
REDIS_URL=""
